# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in your Supabase dashboard under Project Settings -> API.
# Without these the site still runs, serving the bundled content in src/lib/seedData.ts,
# but the admin panel, contact form, and newsletter signup stay disabled.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
